  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Tractor.Exercise
  id: 13
  spawnPoint: {fileID: 389859394}
  exerciseName: "\u0410\u0433\u0440\u0435\u0433\u0430\u0442\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u0435
    \u0442\u0440\u0430\u043A\u0442\u043E\u0440\u0430 \u0441 \u043F\u0440\u0438\u0446\u0435\u043F\u043E\u043C"
  exerciseDescription: "\u041E\u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0438\u0442\u044C
    \u043D\u0430\u0447\u0430\u043B\u043E \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u0435,
    \u043F\u043E\u0434\u044A\u0435\u0445\u0430\u0442\u044C \u043A \u043F\u0440\u0438\u0446\u0435\u043F\u0443
    \u0437\u0430\u0434\u043D\u0438\u043C \u0445\u043E\u0434\u043E\u043C, \u043E\u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0438\u0442\u044C
    \u0441\u0446\u0435\u043F\u043A\u0443, \u0434\u043E\u0435\u0445\u0430\u0442\u044C
    \u0434\u043E \u0443\u043A\u0430\u0437\u0430\u043D\u043D\u043E\u0439 \u0442\u043E\u0447\u043A\u0438
    \u0432\u043C\u0435\u0441\u0442\u0435 \u0441 \u043F\u0440\u0438\u0446\u0435\u043F\u043E\u043C,
    \u0441\u043E\u0432\u0435\u0440\u0448\u0438\u0442\u044C \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0443
    \u0432 \u0443\u043A\u0430\u0437\u0430\u043D\u043D\u043E\u043C \u043C\u0435\u0441\u0442\u0435"
