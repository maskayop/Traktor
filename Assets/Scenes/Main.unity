  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Tractor.Exercise
  id: 7
  spawnPoint: {fileID: 679343549}
  exerciseName: "\u041F\u0440\u0430\u0432\u044B\u0439 \u0440\u0430\u0437\u0432\u043E\u0440\u043E\u0442
    \u0432 \u043E\u0433\u0440\u0430\u043D\u0438\u0447\u0435\u043D\u043D\u043E\u043C
    \u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u0441\u0442\u0432\u0435"
  exerciseDescription: "\u041E\u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0438\u0442\u044C
    \u043D\u0430\u0447\u0430\u043B\u043E \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u0435,
    \u0432\u044A\u0435\u0445\u0430\u0442\u044C \u0432 \u0437\u043E\u043D\u0443 \u0432\u044B\u043F\u043E\u043B\u043D\u0435\u043D\u0438\u044F
    \u0443\u043F\u0440\u0430\u0436\u043D\u0435\u043D\u0438\u044F, \u0441\u043E\u0432\u0435\u0440\u0448\u0438\u0442\u044C
    \u0440\u0430\u0437\u0432\u043E\u0440\u043E\u0442 \u0432 \u043E\u0433\u0440\u0430\u043D\u0438\u0447\u0435\u043D\u043D\u043E\u043C
    \u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u0441\u0442\u0432\u0435 \u0432
    \u043F\u0440\u0430\u0432\u0443\u044E \u0441\u0442\u043E\u0440\u043E\u043D\u0443,
    \u0432\u044B\u0435\u0445\u0430\u0442\u044C \u0438\u0437 \u0437\u043E\u043D\u044B
    \u0432\u044B\u043F\u043E\u043B\u043D\u0435\u043D\u0438\u044F \u0443\u043F\u0440\u0430\u0436\u043D\u0435\u043D\u0438\u044F,
    \u0441\u043E\u0432\u0435\u0440\u0448\u0438\u0442\u044C \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0443
    \u0432 \u0443\u043A\u0430\u0437\u0430\u043D\u043D\u043E\u043C \u043C\u0435\u0441\u0442\u0435"
