    \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u044F, \u0432\u0435\u0440\u043D\u0443\u0442\u044C\u0441\u044F
    \u0432 \u0441\u0432\u043E\u044E \u043F\u043E\u043B\u043E\u0441\u0443 \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u044F,
    \u0441\u043E\u0432\u0435\u0440\u0448\u0438\u0442\u044C \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0443
    \u0432 \u0443\u043A\u0430\u0437\u0430\u043D\u043D\u043E\u043C \u043C\u0435\u0441\u0442\u0435"
