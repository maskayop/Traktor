  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 93a8ecf08431fd34ea60e659a75c4148, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Tractor.Exercise
  id: 5
  spawnPoint: {fileID: 1096458334}
  exerciseName: "\u041E\u0431\u044A\u0435\u0437\u0434 \u043F\u0440\u0435\u043F\u044F\u0442\u0441\u0442\u0432\u0438\u044F"
  exerciseDescription: "\u041E\u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0438\u0442\u044C
    \u043D\u0430\u0447\u0430\u043B\u043E \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u0435,
    \u0434\u043E\u0435\u0445\u0430\u0442\u044C \u0434\u043E \u0443\u043A\u0430\u0437\u0430\u043D\u043D\u043E\u0433\u043E
    \u043F\u0440\u0435\u043F\u044F\u0442\u0441\u0442\u0432\u0438\u044F, \u0441\u043E\u0432\u0435\u0440\u0448\u0438\u0442\u044C
    \u043E\u0431\u044A\u0435\u0437\u0434 \u043F\u0440\u0435\u043F\u044F\u0442\u0441\u0442\u0432\u0438\u044F
    \u0441 \u043B\u0435\u0432\u043E\u0439 \u0441\u0442\u043E\u0440\u043E\u043D\u044B
    \u043F\u043E \u043F\u043E\u043B\u043E\u0441\u0435 \u0432\u0441\u0442\u0440\u0435\u0447\u043D\u043E\u0433\u043E
    \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u044F, \u0432\u0435\u0440\u043D\u0443\u0442\u044C\u0441\u044F
    \u0432 \u0441\u0432\u043E\u044E \u043F\u043E\u043B\u043E\u0441\u0443 \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u044F,
    \u0441\u043E\u0432\u0435\u0440\u0448\u0438\u0442\u044C \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0443
    \u0432 \u0443\u043A\u0430\u0437\u0430\u043D\u043D\u043E\u043C \u043C\u0435\u0441\u0442\u0435"
