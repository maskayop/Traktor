  id: 12
  spawnPoint: {fileID: 1864680993}
  exerciseName: "\"\u042D\u0441\u0442\u0430\u043A\u0430\u0434\u0430\""
  exerciseDescription: "\u041E\u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0438\u0442\u044C
    \u043D\u0430\u0447\u0430\u043B\u043E \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u0435,
    \u0434\u043E\u0435\u0445\u0430\u0442\u044C \u0434\u043E \u0443\u043A\u0430\u0437\u0430\u043D\u043D\u043E\u0439
    \u0442\u043E\u0447\u043A\u0438 \u043D\u0430 \u043F\u043E\u0434\u044A\u0451\u043C\u0435,
    \u043E\u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0438\u0442\u044C \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0443
    \u0438 \u0442\u0440\u043E\u0433\u0430\u043D\u044C\u0435 \u043D\u0430 \u043F\u043E\u0434\u044A\u0451\u043C\u0435,
    \u0441\u043E\u0432\u0435\u0440\u0448\u0438\u0442\u044C \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0443
    \u0432 \u0443\u043A\u0430\u0437\u0430\u043D\u043D\u043E\u043C \u043C\u0435\u0441\u0442\u0435"
