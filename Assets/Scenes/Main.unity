  id: 11
  spawnPoint: {fileID: 1104076926}
  exerciseName: "\"\u0411\u043E\u043B\u044C\u0448\u0430\u044F \u0437\u043C\u0435\u0439\u043A\u0430\""
  exerciseDescription: "\u041E\u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0438\u0442\u044C
    \u043D\u0430\u0447\u0430\u043B\u043E \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u0435,
    \u043F\u0440\u043E\u0435\u0445\u0430\u0442\u044C \u0447\u0435\u0440\u0435\u0437
    \u0443\u043A\u0430\u0437\u0430\u043D\u043D\u044B\u0435 \u0442\u043E\u0447\u043A\u0438
    \u043F\u0435\u0440\u0435\u0434\u043D\u0438\u043C, \u0430 \u0437\u0430\u0442\u0435\u043C
    \u0437\u0430\u0434\u043D\u0438\u043C \u0445\u043E\u0434\u043E\u043C, \u0441\u043E\u0432\u0435\u0440\u0448\u0438\u0442\u044C
    \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0443 \u0432 \u0443\u043A\u0430\u0437\u0430\u043D\u043D\u043E\u043C
    \u043C\u0435\u0441\u0442\u0435"
