--- !u!102 &835375264
TextMesh:
  serializedVersion: 3
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 835375262}
  m_Text: 'Adjusting the camera perspective of the top

    view is beneficial for
    rendering both simple

    plane or low-poly grass, as well as high-poly

    grass.
    This perspective minimizes the visual

    ugliness of the grass planes, helping
    to create

    a more cohesive and visually appealing scene.


    Turn it on
    and off to see the difference.'
  m_OffsetZ: 0
  m_CharacterSize: 1
  m_LineSpacing: 1
