--- !u!102 &159081547
TextMesh:
  serializedVersion: 3
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 159081545}
  m_Text: "This example showcases how two distinct\ntypes of vegetation interactions
    are implemented.\n\nFULL PHYSICS INTERACTION\n\r\nWorks on trees and plants with
    an unlimited\nnumber of interactors. Limitations: Doesn't work\non terrain objects.\r\n\r\nSIMPLE
    PLAYER INTERACTION\n\r\nWorks on all plants like the previous\ninteraction but
    with a more realistic simulation.\nLimitations: Only works with one interactor.\r\n\rBut
    not the multiplayer shader interaction.\r\n\r\nClick \"Play\" to see it in action.
    \nUse: Left, Right, Up, Down keys to move the player."
  m_OffsetZ: 0
  m_CharacterSize: 1
  m_LineSpacing: 1
  m_Anchor: 0
  m_Alignment: 0
  m_TabSize: 4
